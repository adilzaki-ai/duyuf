# Copy to .env.local (never committed).
#   auto      platform when VITE_DUYUF_API_URL is set, else the sample
#   mock      always the sample (sample/demo.json), no backend needed
#   platform  always the backend
VITE_DATA_SOURCE=auto
VITE_DUYUF_API_URL=/
# Leave empty: staff sign in with email and password. A key from
# backend/scripts/issue_key.py here skips sign in (development only).
VITE_DUYUF_API_KEY=
# fall back to the sample, with a banner, if the backend cannot be reached
VITE_MOCK_FALLBACK=true
